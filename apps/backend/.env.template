STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend
# Stripe (https://dashboard.stripe.com/apikeys). Leave empty to disable online payments.
# Enable Bizum, Apple Pay, Google Pay and Amazon Pay in Settings > Payment methods.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Multi-language content (es, ca, en)
MEDUSA_FF_TRANSLATION=true

# Production (see DEPLOY.md)
# MEDUSA_WORKER_MODE=server        # "server" on the web service, "worker" on the worker
# DISABLE_MEDUSA_ADMIN=false       # "true" on the worker
# MEDUSA_BACKEND_URL=https://api.example.com
# Product photos (Cloudflare R2 or any S3-compatible storage)
# S3_BUCKET=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FILE_URL=https://pub-xxxx.r2.dev

# Market analysis price reader (Analisis de mercado)
# MARKET_READER_CONTACT=email-or-web-shown-in-the-user-agent
# MARKET_READER_DELAY_MS=6000       # wait between two requests to the same shop (minimum 3000)
# MARKET_READER_ENABLED=false       # switch off the nightly reader

# Order emails (optional). Without SMTP_HOST they are only logged.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SHOP_ORDERS_EMAIL=
STOREFRONT_URL=http://localhost:8000
